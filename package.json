{
  "name": "@tecuity/barcode-generator",
  "version": "1.2.1",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "index.cjs",
    "index.mjs",
    "index.umd.js",
    "index.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tecuity/barcode-generator"
  },
  "homepage": "https://tecuity.github.io/barcode-generator/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node process.js && node build.js",
    "start-site": "parcel demo-site/index.html --out-dir site-dist",
    "build-site": "parcel build demo-site/index.html --out-dir docs --public-url https://tecuity.github.io/barcode-generator/",
    "pretest": "node process.js",
    "test": "vitest run",
    "pretest:ci": "node process.js",
    "test:ci": "vitest run",
    "copy-manifest": "node -e \"require('node:fs').copyFileSync('package.json','dist/package.json')\"",
    "postversion": "npm run build && npm run copy-manifest",
    "pack:preview": "npm run build && npm run copy-manifest && npm pack ./dist --dry-run",
    "release:preview": "np --preview",
    "release": "np"
  },
  "publishConfig": {
    "access": "public"
  },
  "np": {
    "contents": "dist",
    "testScript": "test:ci"
  },
  "devDependencies": {
    "@babel/core": "^7.8.4",
    "@babel/preset-env": "^7.8.4",
    "@emotion/core": "^10.0.27",
    "@emotion/styled": "^10.0.27",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "all-contributors-cli": "^6.13.0",
    "normalize.css": "^8.0.1",
    "np": "^12.0.1",
    "parcel": "^2.0.0-beta.1",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "rollup": "^4.62.4",
    "vitest": "^4.1.10"
  }
}
